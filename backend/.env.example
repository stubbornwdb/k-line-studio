# Copy to .env and adjust. All values are optional.

# SQLite (default) -- file is created on first run
DATABASE_URL=sqlite+aiosqlite:///./data/kline.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://kline:kline@localhost:5432/kline

DEBUG=false
DB_ECHO=false

# Comma separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outbound requests to exchange APIs
HTTP_TIMEOUT=20
# Set if Binance/OKX is geo-blocked or you route through a proxy
# HTTP_PROXY=http://127.0.0.1:7890
HTTP_MAX_RETRIES=3
FETCH_PAGE_DELAY=0.12

# Guard rails
MAX_CANDLES_PER_REQUEST=60000
SYMBOLS_CACHE_TTL=900
